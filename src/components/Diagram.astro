---
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="my-8 border border-[var(--border)] rounded-lg p-6 bg-[var(--bg-subtle)]">
  <slot />
  {caption && (
    <figcaption class="mt-3 text-xs text-[var(--text-muted)] text-center">
      {caption}
    </figcaption>
  )}
</figure>
