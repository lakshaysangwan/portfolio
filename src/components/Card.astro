---
interface Props {
  href: string;
  title: string;
  description: string;
  meta?: string;    // e.g. year or status
  badge?: string;   // e.g. category chip
  external?: boolean;
}

const { href, title, description, meta, badge, external = false } = Astro.props;
---

<a
  href={href}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  class="group block border border-[var(--border)] rounded-lg p-5 hover:border-[var(--accent)] transition-colors no-underline"
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h3 class="text-[var(--text)] font-medium text-base leading-snug group-hover:text-[var(--accent)] transition-colors m-0">
        {title}
      </h3>
      <p class="text-[var(--text-muted)] text-sm mt-1.5 mb-0 leading-relaxed">
        {description}
      </p>
    </div>
    {(meta || badge) && (
      <div class="flex flex-col items-end gap-1 shrink-0">
        {meta && <span class="text-xs text-[var(--text-muted)] whitespace-nowrap">{meta}</span>}
        {badge && (
          <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-muted)] whitespace-nowrap">
            {badge}
          </span>
        )}
      </div>
    )}
  </div>
</a>
