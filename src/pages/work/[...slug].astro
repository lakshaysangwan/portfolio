---
import Prose from '../../layouts/Prose.astro';
import Chip from '../../components/Chip.astro';
import ImpactCallout from '../../components/ImpactCallout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('work', (e) => !e.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const ogImage = `/og/work-${entry.id}.png`;

const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Lakshay Sangwan',
  },
});
---

<Prose
  title={entry.data.title}
  description={entry.data.description}
  ogImage={ogImage}
  article={true}
  jsonLd={articleJsonLd}
>
  <!-- Back link -->
  <a
    href="/work"
    class="inline-flex items-center gap-1.5 text-sm text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors mb-8 no-underline"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m15 18-6-6 6-6"/>
    </svg>
    All case studies
  </a>

  <!-- Header -->
  <header class="mb-10">
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <Chip label={entry.data.category} />
      <span class="text-sm text-[var(--text-muted)]">{entry.data.timeframe}</span>
      {entry.data.teamSize === 1 && (
        <span class="text-sm text-[var(--text-muted)]">· Solo</span>
      )}
    </div>
    <h1 class="text-2xl sm:text-3xl font-semibold text-[var(--text)] leading-tight mb-3">
      {entry.data.title}
    </h1>
    <p class="text-[var(--text-muted)] text-lg leading-relaxed">
      {entry.data.description}
    </p>

    <!-- Stack -->
    <div class="flex flex-wrap gap-2 mt-4">
      {entry.data.stack.map((tech) => (
        <Chip label={tech} />
      ))}
    </div>
  </header>

  <!-- Impact callout -->
  <ImpactCallout impact={entry.data.impact} />

  <!-- MDX content -->
  <div class="prose">
    <Content />
  </div>
</Prose>
