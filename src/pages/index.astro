---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work', (e) => !e.data.draft);
const allProjects = await getCollection('projects', (e) => !e.data.draft);

const featuredWork = allWork
  .filter((e) => e.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const featuredProjects = allProjects
  .filter((e) => e.data.featured)
  .slice(0, 2);

const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lakshay Sangwan',
  jobTitle: 'Product Engineer',
  worksFor: { '@type': 'Organization', name: 'Digiicampus' },
  url: 'https://lakshaysangwan.dev',
  sameAs: [
    'https://github.com/lakshaysangwan',
    'https://linkedin.com/in/lakshaysangwaan',
  ],
});
---

<Base
  title="Lakshay Sangwan"
  description="Product Engineer at Digiicampus. ~5 years building multi-tenant products and infrastructure on Java, Spring Boot, AWS, and the modern web."
  jsonLd={personJsonLd}
>
  <!-- Hero -->
  <section class="max-w-[680px] mx-auto px-4 sm:px-6 pt-16 pb-12 sm:pt-20 sm:pb-16">
    <h1 class="text-3xl sm:text-4xl font-semibold text-[var(--text)] leading-tight mb-4">
      Lakshay Sangwan
    </h1>
    <p class="text-lg text-[var(--text-muted)] leading-relaxed mb-8 max-w-[560px]">
      Product Engineer at Digiicampus. ~5 years building multi-tenant products and
      infrastructure on Java, Spring Boot, AWS, and the modern web.
      Based in Hisar, India.
    </p>
    <div class="flex flex-wrap items-center gap-3">
      <a
        href="/work"
        class="inline-flex items-center px-4 py-2 rounded-md bg-[var(--text)] text-[var(--bg)] text-sm font-medium hover:opacity-80 transition-opacity"
      >
        View work
      </a>
      <a
        href="mailto:lakshay.ib.hisar@gmail.com"
        class="inline-flex items-center px-4 py-2 rounded-md border border-[var(--border)] text-[var(--text)] text-sm font-medium hover:border-[var(--accent)] transition-colors"
      >
        Email
      </a>
      <div class="flex items-center gap-3 text-sm text-[var(--text-muted)]">
        <a
          href="https://github.com/lakshaysangwan"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--text)] transition-colors"
        >
          GitHub
        </a>
        <span aria-hidden="true">·</span>
        <a
          href="https://linkedin.com/in/lakshaysangwaan"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--text)] transition-colors"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="max-w-[1100px] mx-auto px-4 sm:px-6 py-12 border-t border-[var(--border)]">
    <div class="mb-8">
      <h2 class="text-xl font-semibold text-[var(--text)] mb-1">Selected work</h2>
      <p class="text-[var(--text-muted)] text-sm">A few things I've built end-to-end.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featuredWork.map((entry) => (
        <Card
          href={`/work/${entry.id}`}
          title={entry.data.title}
          description={entry.data.description}
          meta={entry.data.timeframe}
          badge={entry.data.category}
        />
      ))}
    </div>
    <div class="mt-6">
      <a
        href="/work"
        class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors"
      >
        See all case studies →
      </a>
    </div>
  </section>

  <!-- Side projects -->
  <section class="max-w-[1100px] mx-auto px-4 sm:px-6 py-12 border-t border-[var(--border)]">
    <div class="mb-8">
      <h2 class="text-xl font-semibold text-[var(--text)] mb-1">Side projects</h2>
      <p class="text-[var(--text-muted)] text-sm">Things I build when I'm not at work.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {featuredProjects.map((entry) => (
        <Card
          href={`/projects/${entry.id}`}
          title={entry.data.name}
          description={entry.data.tagline}
          badge={entry.data.status}
        />
      ))}
    </div>
    <div class="mt-6">
      <a
        href="/projects"
        class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors"
      >
        See all projects →
      </a>
    </div>
  </section>
</Base>
