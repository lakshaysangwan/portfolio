---
import Base from '../../layouts/Base.astro';
import Chip from '../../components/Chip.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('projects', (e) => !e.data.draft);

// Fixed order per PRD §4.4
const order = ['docukit', 'habitflow', 'beautify-whatsapp-export', 'barcelona-match-cron', 'careers360-scrapper'];
const sorted = order
  .map((id) => entries.find((e) => e.id === id))
  .filter((e): e is NonNullable<typeof e> => e != null);
---

<Base
  title="Projects"
  description="Side projects — things I build to learn, scratch an itch, or automate something boring."
>
  <div class="max-w-[1100px] mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="max-w-[680px] mb-10">
      <h1 class="text-3xl font-semibold text-[var(--text)] mb-4">Projects</h1>
      <p class="text-[var(--text-muted)] leading-relaxed">
        Side projects — things I build to learn, scratch an itch, or automate
        something boring. Some are live products, some are quick experiments.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {sorted.map((entry) => (
        <a
          href={`/projects/${entry.id}`}
          class="group block border border-[var(--border)] rounded-lg p-5 hover:border-[var(--accent)] transition-colors no-underline"
        >
          <div class="flex items-start justify-between gap-3 mb-3">
            <h2 class="text-base font-medium text-[var(--text)] group-hover:text-[var(--accent)] transition-colors leading-snug m-0">
              {entry.data.name}
            </h2>
            <Chip
              label={entry.data.status === 'live' ? 'Live' : entry.data.status === 'archived' ? 'Archived' : 'WIP'}
              active={entry.data.status === 'live'}
            />
          </div>
          <p class="text-sm text-[var(--text-muted)] leading-relaxed mb-4">
            {entry.data.tagline}
          </p>
          <div class="flex flex-wrap gap-1.5">
            {entry.data.stack.slice(0, 3).map((tech) => (
              <span class="text-xs px-2 py-0.5 rounded bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-muted)]">
                {tech}
              </span>
            ))}
            {entry.data.stack.length > 3 && (
              <span class="text-xs text-[var(--text-muted)]">+{entry.data.stack.length - 3}</span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
