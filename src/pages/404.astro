---
import Prose from '../layouts/Prose.astro';
---

<Prose
  title="Page not found"
  description="This page doesn't exist."
>
  <p class="text-sm font-medium text-[var(--accent)] mb-2">404</p>
  <h1 class="text-2xl sm:text-3xl font-semibold text-[var(--text)] leading-tight mb-4">
    Page not found
  </h1>
  <p class="text-[var(--text-muted)] leading-relaxed mb-8">
    The page you're looking for doesn't exist or has moved.
  </p>
  <div class="flex flex-wrap items-center gap-3">
    <a
      href="/"
      class="inline-flex items-center px-4 py-2 rounded-md bg-[var(--text)] text-[var(--bg)] text-sm font-medium hover:opacity-80 transition-opacity"
    >
      Go home
    </a>
    <a
      href="/work"
      class="inline-flex items-center px-4 py-2 rounded-md border border-[var(--border)] text-[var(--text)] text-sm font-medium hover:border-[var(--accent)] transition-colors"
    >
      View work
    </a>
  </div>
</Prose>
