---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  article?: boolean;
  jsonLd?: string;
}

const props = Astro.props;
---

<Base {...props}>
  <div class="max-w-[680px] mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <slot />
  </div>
</Base>
